<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
<% for (post of posts){ %>
    <div class="post">
        <h1><%= post.username %></h1>
        <p><%= post.content %></p>

        <!-- <a href="http://localhost:5000/post/<%= post.username %>/edit">Edit Post</a>&emsp;
        <a href="http://localhost:5000/post/<%= post.username %>/delete">delete post</a> -->
        <a href="/post/<%= post.username %>/edit">Edit Post</a>&emsp;
        <a href="/post/<%= post.username %>/delete">delete post</a>
    </div>
<% } %>

        <!-- <a href="http://localhost:5000/post/new" class="create_link">Create New Post</a> -->
         <a href="/post/new" class="create_link">Create New Post</a>

</body>
</html>

